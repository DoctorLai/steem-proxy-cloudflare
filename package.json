{
  "name": "steem-proxy-cloudflare",
  "version": "2026.8.10",
  "private": true,
  "type": "module",
  "description": "Serverless Cloudflare Worker proxy that selects the healthiest Steem RPC node automatically.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "npm run format && npm run lint && npm run coverage && npm run build",
    "coverage": "vitest --run --coverage",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest --run",
    "test:watch": "vitest",
    "lint": "eslint src tests *.config.js",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.9.6",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  },
  "license": "MIT"
}
